{
  "name": "@brazil-tms/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./schema": "./schema/index.ts",
    "./storage": "./src/storage.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "drizzle:migrate": "drizzle-kit migrate",
    "db:seed": "tsx ./seed/001-admin.ts",
    "db:seed:e2e": "tsx ./seed/e2e-accounts.ts",
    "db:seed:master-data": "tsx ./seed/master-data-sample.ts",
    "db:seed:trip-domain": "tsx ./seed/trip-domain-sample.ts",
    "db:seed:import": "tsx ./seed/import-sample.ts",
    "db:seed:reason-codes": "tsx ./seed/reason-codes.ts",
    "db:seed:sla-rules": "tsx ./seed/sla-rules.ts",
    "db:seed:document-types": "tsx ./seed/document-types.ts",
    "db:seed:rates": "tsx ./seed/rates.ts",
    "db:seed:buckets": "tsx ./seed/storage-buckets.ts",
    "db:seed:all": "pnpm run db:seed:master-data && pnpm run db:seed:reason-codes && pnpm run db:seed:document-types && pnpm run db:seed:sla-rules && pnpm run db:seed:rates && pnpm run db:seed:import && pnpm run db:seed && pnpm run db:seed:trip-domain && pnpm run db:seed:buckets"
  },
  "dependencies": {
    "@brazil-tms/shared": "workspace:*",
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": ">=0.36.0",
    "postgres": "^3.4.4"
  },
  "devDependencies": {
    "@types/node": "^22.8.0",
    "drizzle-kit": ">=0.28.0",
    "tsx": "^4.19.0"
  }
}
