# Copy to infra/supabase/.env and fill in. NEVER commit the real .env.

# --- Postgres ---
POSTGRES_PASSWORD=postgres-super-secret-change-me
POSTGRES_DB=postgres
# Host port for Postgres (the container always listens on 5432). Use 5433 if 5432 is taken locally.
SUPABASE_DB_PORT=5432

# --- Public URLs ---
API_EXTERNAL_URL=http://localhost:8000
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=http://localhost:3000/**

# --- JWT / keys ---
# JWT_SECRET signs the GoTrue tokens. ANON_KEY (publishable) and SERVICE_ROLE_KEY (secret) are JWTs
# signed with JWT_SECRET carrying role=anon / role=service_role. Generate them with that secret (a
# small HMAC-SHA256 signer, or the Supabase docs). Keep SERVICE_ROLE_KEY server-only (never in any
# NEXT_PUBLIC_* var).
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
ANON_KEY=replace-with-anon-jwt-signed-by-JWT_SECRET
SERVICE_ROLE_KEY=replace-with-service-role-jwt-signed-by-JWT_SECRET

# --- Session policy (FR-003a) [VERIFY AT SETUP] ---
# GOTRUE_SESSIONS_* are set in docker-compose.yml; if the idle timeout is not honored on the pinned
# GoTrue image, wire the app-layer last_active_at fallback (research §4; task T061).

# --- SMTP (invite + forgot-password) ---
# Defaults (in docker-compose.yml) point at the local Mailpit catcher (UI http://localhost:8025), so
# invite/recovery emails work locally without real SMTP. Override these for a real mail provider.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=mailpit
SMTP_PASS=mailpit
SMTP_ADMIN_EMAIL=noreply@braziltransports.com.br
SMTP_SENDER_NAME=Brazil Transports TMS
