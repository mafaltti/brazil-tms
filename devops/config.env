# Brazil TMS — valores deste deploy para o devops/ctl.sh.
#
# Toda linha usa ${VAR:-padrão}: qualquer valor pode ser sobrescrito por variável
# de ambiente na hora de rodar, sem editar arquivo nenhum. Ex.:
#   WEB_PORT=3100 bash devops/ctl.sh status
#
# ATENÇÃO: mexer em porta ou em URL pública exige `ctl.sh env` + `ctl.sh build`
# de novo — as variáveis NEXT_PUBLIC_* entram no bundle do Next em tempo de build.

# --- identidade -------------------------------------------------------------
SERVICO="${SERVICO:-brazil-tms}"
NOME_LONGO="${NOME_LONGO:-Brazil TMS}"

# Rótulo do ambiente. "prod" é o padrão. Qualquer outro valor (ex.: "dev") cria um
# deploy PARALELO e isolado: outro projeto Docker (containers/volumes próprios),
# outra pasta de estado, outros logs, outra marca de cron. Use com as portas +100.
AMBIENTE="${AMBIENTE:-prod}"

# --- portas no host ---------------------------------------------------------
WEB_PORT="${WEB_PORT:-3000}"           # Next.js (next start) — é o que o usuário acessa
WEB_HOST="${WEB_HOST:-0.0.0.0}"        # interface de escuta do Next
GATEWAY_PORT="${GATEWAY_PORT:-8000}"   # Caddy: /auth/v1 (GoTrue) + /storage/v1 (Storage)
DB_PORT="${DB_PORT:-5432}"             # Postgres do container, publicado no host
MAILPIT_PORT="${MAILPIT_PORT:-8025}"   # UI do capturador de e-mail (convites/recuperação)

# --- endereço público -------------------------------------------------------
# Host pelo qual o NAVEGADOR do usuário chega na VM. Deixe "localhost" só se o
# sistema for usado de dentro da própria VM (ou por túnel SSH). Acessando pela
# rede, ponha aqui o IP/DNS da VM — senão a tela de definir senha (convite e
# "esqueci minha senha") quebra: ela fala com o gateway direto do navegador.
PUBLIC_HOST="${PUBLIC_HOST:-localhost}"
SITE_URL="${SITE_URL:-http://$PUBLIC_HOST:$WEB_PORT}"
SUPABASE_PUBLIC_URL="${SUPABASE_PUBLIC_URL:-http://$PUBLIC_HOST:$GATEWAY_PORT}"

# --- primeiro admin ---------------------------------------------------------
# A senha temporária é sorteada pelo `ctl.sh env` e guardada no cofre local
# (STATE_DIR/secrets.env). O sistema força a troca no primeiro login.
ADMIN_EMAIL="${ADMIN_EMAIL:-admin@braziltransports.com.br}"

# --- caminhos ---------------------------------------------------------------
# Raiz de dados/logs fora do repositório (mesmo padrão dos outros sistemas).
KOMUNICK_BASE="${KOMUNICK_BASE:-$HOME/komunick}"
# Vazios = calculados: $KOMUNICK_BASE/data/<id> e $KOMUNICK_BASE/logs.
# <id> é "brazil-tms" em prod e "brazil-tms-<ambiente>" nos demais.
STATE_DIR="${STATE_DIR:-}"
LOG_DIR="${LOG_DIR:-}"

# --- runtime ----------------------------------------------------------------
# Binário do Node. Vazio = descobre sozinho (nvm v22 → maior versão → PATH).
# Node 22 é obrigatório: na v20 o @supabase/realtime-js quebra todo createClient
# ("no native WebSocket"). v26 nunca foi validada com este lock.
NODE_BIN="${NODE_BIN:-}"
# Teto de heap do build do Next (MB). A VM tem 3,8 GB; 2048 é o valor validado.
BUILD_MAX_MB="${BUILD_MAX_MB:-2048}"

# --- docker compose ---------------------------------------------------------
# Nome do projeto Compose (isola containers, volumes e rede). Vazio = calculado:
# "brazil-tms-supabase" em prod (igual ao `name:` do compose) e
# "brazil-tms-<ambiente>-supabase" nos demais.
COMPOSE_PROJECT="${COMPOSE_PROJECT:-}"
# Serviços do compose que sobem. O serviço `worker` do compose fica de fora de
# propósito: o worker roda no host (economiza RAM e facilita ver log/reiniciar).
INFRA_SERVICES="${INFRA_SERVICES:-db auth storage gateway mailpit}"

# --- opcional ---------------------------------------------------------------
# Extração de dados de documento por IA (apps/web/lib/ai/extract-document.ts).
# Sem chave o recurso responde 503 e o resto do sistema funciona normalmente.
ANTHROPIC_API_KEY="${ANTHROPIC_API_KEY:-}"
# Branch usado pelo `ctl.sh update`. Vazio = o branch em que o clone já está.
GIT_BRANCH="${GIT_BRANCH:-}"
